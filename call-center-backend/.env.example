# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/call_center_wfm?schema=public

# REQUIRED in production: long random string used to sign JWTs
JWT_SECRET=change-me
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Python forecasting / optimisation service
FORECAST_SERVICE_URL=http://localhost:8000
# FORECAST_API_KEY=shared-secret
# SCHEDULER_ENGINE=greedy   # skip OR-Tools and use the built-in heuristic

# Optional: Redis for real-time queue metrics (falls back to memory)
# REDIS_URL=redis://localhost:6379

# Optional: e-mail notifications
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Workforce360 <no-reply@example.com>"
